#!/bin/sh
# pre-commit: HuggingFace / APIトークンのコミット防止チェック
#
# セットアップ: cp .git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# または: git config core.hooksPath .git-hooks

# チェックするパターン（正規表現）
PATTERNS=(
  'hf_[a-zA-Z0-9]{30,}'       # HuggingFace token: hf_xxx...
  'sk-[a-zA-Z0-9]{30,}'       # OpenAI API key
  'ghp_[a-zA-Z0-9]{30,}'      # GitHub Personal Access Token
  '"hfToken"\s*:\s*"hf_'      # JSON内のhfToken値
)

FOUND=0

for pattern in "${PATTERNS[@]}"; do
  # ステージングエリア（差分）を検索
  if git diff --cached --name-only | xargs grep -lE "$pattern" 2>/dev/null | grep -q .; then
    MATCHING_FILES=$(git diff --cached --name-only | xargs grep -lE "$pattern" 2>/dev/null)
    echo "❌ [pre-commit] シークレットが検出されました: パターン '$pattern'"
    echo "   該当ファイル:"
    echo "$MATCHING_FILES" | sed 's/^/     - /'
    FOUND=1
  fi
done

if [ "$FOUND" -eq 1 ]; then
  echo ""
  echo "🔒 コミットをブロックしました。"
  echo "   設定値は settings.json（git管理外）または環境変数に移動してください。"
  echo "   どうしてもコミットする場合: git commit --no-verify"
  exit 1
fi

exit 0
